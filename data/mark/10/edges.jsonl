{"from": "passage:mk-10-15", "type": "asserts", "to": "claim:mt-18-03-04-become-like-children"}
{"from": "passage:mk-10-15", "type": "parallels", "to": "passage:mt-18-03", "note": "'Whoever will not receive God's Kingdom like a little child will in no way enter into it' parallels 'turn and become like little children'."}
