{"from": "text:1-enoch-22", "type": "documented_by", "to": "source:wikisource-1-enoch-22"}
{"from": "text:4-maccabees-13-17", "type": "documented_by", "to": "source:wikipedia-bosom-abraham"}
{"from": "text:josephus-discourse-hades", "type": "documented_by", "to": "source:wikipedia-discourse-hades"}
{"from": "text:4-maccabees-13-17", "type": "related_to", "to": "claim:lk-16-22-23-afterlife-divided", "note": "Cross-reference (deuterocanon): martyrs expect that after death 'Abraham, Isaac, and Jacob will receive us' - the bosom of the patriarchs in the period."}
